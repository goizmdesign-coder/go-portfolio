
---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      Go Izumita / 泉田剛 — Artist &
      Architectural Designer
    </title>

    <meta
      name="description"
      content="Portfolio of Go Izumita, a Japanese artist and architectural designer working across sculpture, installation, architecture, spatial design, and architectural visualization."
    />

    <meta
      property="og:title"
      content="Go Izumita / 泉田剛"
    />

    <meta
      property="og:description"
      content="Artist and Architectural Designer"
    />

    <meta
      property="og:image"
      content="https://goizumita.com/images/og.jpg"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content="https://goizumita.com"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/favicon.png"
    />
  </head>

  <body>
    <Header />

    <main class="home-grid">
      <a
        href="/projects/technofossilarchive"
        class="work-item"
      >
        <img
          src="/images/TFA.gif"
          alt="Technofossil Archive — Go Izumita"
        />

        <div class="work-title">
          Technofossil Archive
        </div>
      </a>

      <a
        href="/projects/encounters"
        class="work-item"
      >
        <img
          src="/images/work-02.gif"
          alt="ENCOUNTERS — Go Izumita"
        />

        <div class="work-title">
          ENCOUNTERS 2026
        </div>
      </a>

      <a
        href="/projects/disassembly"
        class="work-item"
      >
        <img
          src="/images/work-01.gif"
          alt="Disassembly and Memory — Go Izumita"
        />

        <div class="work-title">
          Disassembly and Memory
        </div>
      </a>

      <a
        href="/projects/architecture-complexity-mapping"
        class="work-item"
      >
        <img
          src="/images/work-03.gif"
          alt="Architecture Complexity Mapping — Go Izumita"
        />

        <div class="work-title">
          Architecture Complexity
          Mapping
          <br />
          Patterns of Architecture
        </div>
      </a>

      <a
        href="/projects/revolve"
        class="work-item"
      >
        <img
          src="/images/work-04.gif"
          alt="R/EVOLVE — Go Izumita"
        />

        <div class="work-title">
          R/EVOLVE
        </div>
      </a>

      <a
        href="/projects/africaya-renovation"
        class="work-item"
      >
        <img
          src="/images/africaya.gif"
          alt="Africaya Renovation — Go Izumita"
        />

        <div class="work-title">
          Africaya Renovation
        </div>
      </a>
    </main>

    <Footer />
  </body>
</html>
